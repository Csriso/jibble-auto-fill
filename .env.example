# Your normal login credentials for https://web.jibble.io (email + password).
# Only used to fill in the login form in the automated browser; never sent
# anywhere else and never written to logs.
JIBBLE_EMAIL=
JIBBLE_PASSWORD=

TIMEZONE=Europe/Madrid

# Optional. Empty = auto-detect (START_DATE) and today (END_DATE). FORMAT: 2025-11-27
START_DATE=
END_DATE=

# Work schedule (see README > Configurable schedule). Empty = defaults to
# 08:00-12:00 / 14:00-18:00 (split shift, 4 punches).
WORK_START_TIME=08:00
WORK_END_TIME=18:00
# BREAK_START_TIME/BREAK_END_TIME: leave BOTH empty for a single shift (2
# punches, no break); fill in both for a split shift (4 punches).
BREAK_START_TIME=12:00
BREAK_END_TIME=14:00

# Pause between each punch creation during 'npm run fill', in milliseconds.
# 0 = no pause. Raise this (e.g. 200) if you see lots of 429 Too Many Requests
# in the logs; the client already retries on its own, but spacing requests out helps.
CREATE_DELAY_MS=0

# Only affects 'npm run inspect' (optional diagnostic tool).
# dry-run/fill/verify/gaps never open a window: they use an internal headless
# Chromium only to capture the session token, and everything else goes over direct HTTP.
HEADLESS=false
